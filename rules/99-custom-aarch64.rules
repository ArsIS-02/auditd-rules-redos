# ==============================================================================
#  auditd: свод правил для РЕД ОС, архитектура aarch64 (ARM64)
#  Оптимизирован для отправки в SIEM (Graylog / Wazuh): максимум сигнала,
#  минимум фонового шума.
#
#  Версия набора: 1.5
#  Статус: проверен на 4 хостах РЕД ОС aarch64 (audit 3.1.3, SELinux Disabled),
#          auditctl -l показывает 55 правил.
#
#  Особенности aarch64:
#   * в ядре нет «старых» syscall (chmod, chown, open, rename, unlink, mkdir,
#     link, symlink, rmdir...) — используются только варианты *at;
#   * правила arch=b32 не используются (32-битных приложений на этих хостах нет);
#   * правил с -F subj_type нет: они требуют работающего SELinux.
#
#  Порядок важен: auditctl -R останавливается на ПЕРВОЙ ошибке, поэтому одна
#  битая строка в середине файла означает, что всё ниже неё не загрузится.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Служебные параметры
# ------------------------------------------------------------------------------
# Удалить все ранее загруженные правила (иначе — "Rule exists")
-D
# Буфер ядра на 8192 события
-b 8192
# При переполнении — сообщение в syslog, система продолжает работу
-f 1

# ------------------------------------------------------------------------------
# 2. Исключения (шум) — идут раньше остальных правил
# ------------------------------------------------------------------------------
-a never,exclude -F msgtype=CRYPTO_KEY_USER

# ------------------------------------------------------------------------------
# 3. Защита самой подсистемы аудита
# ------------------------------------------------------------------------------
-w /etc/audit/ -p wa -k auditconfig
-w /etc/audisp/ -p wa -k audispconfig
-w /var/log/audit/ -p wa -k auditlog
-w /sbin/auditctl -p x -k audit_tools
-w /sbin/auditd -p x -k audit_tools
-w /usr/sbin/ausearch -p x -k audit_tools
-w /usr/sbin/augenrules -p x -k audit_tools

# ------------------------------------------------------------------------------
# 4. Учётные записи и повышение привилегий
# ------------------------------------------------------------------------------
-w /etc/passwd -p wa -k identity_modification
-w /etc/shadow -p wa -k identity_modification
-w /etc/group -p wa -k identity_modification
-w /etc/gshadow -p wa -k identity_modification
-w /etc/security/opasswd -p wa -k identity_modification
-w /usr/bin/sudo -p x -k privilege_escalation
-w /bin/su -p x -k privilege_escalation
-w /usr/sbin/useradd -p x -k user_management
-w /usr/sbin/userdel -p x -k user_management
-w /usr/sbin/usermod -p x -k user_management
-w /usr/sbin/groupadd -p x -k user_management
-w /usr/sbin/groupdel -p x -k user_management
-w /usr/bin/passwd -p x -k user_management

# ------------------------------------------------------------------------------
# 5. Планировщики и закрепление в системе (cron, systemd)
# ------------------------------------------------------------------------------
-w /etc/crontab -p wa -k cron_persistence
-w /etc/cron.d/ -p wa -k cron_persistence
-w /etc/cron.daily/ -p wa -k cron_persistence
-w /etc/cron.hourly/ -p wa -k cron_persistence
-w /etc/cron.weekly/ -p wa -k cron_persistence
-w /etc/cron.monthly/ -p wa -k cron_persistence
-w /var/spool/cron/ -p wa -k cron_persistence
-w /etc/systemd/system/ -p wa -k systemd_persistence
-w /usr/lib/systemd/system/ -p wa -k systemd_persistence

# ------------------------------------------------------------------------------
# 6. Сетевые настройки и подозрительные сетевые утилиты
# ------------------------------------------------------------------------------
-w /etc/hosts -p wa -k network_config
-w /etc/sysconfig/network -p wa -k network_config
-w /etc/NetworkManager/ -p wa -k network_config
-w /usr/sbin/tcpdump -p x -k suspicious_network_tool
-w /usr/bin/nmap -p x -k suspicious_network_tool
-w /usr/bin/nc -p x -k suspicious_network_tool
-w /usr/bin/netcat -p x -k suspicious_network_tool
-w /usr/bin/wget -p x -k suspicious_download
-w /usr/bin/curl -p x -k suspicious_download

# Создание сокетов AF_INET (0x2) и AF_INET6 (0xA) — ТОЛЬКО в пользовательских
# сессиях. auid — это идентификатор входа (loginuid): он сохраняется после
# sudo/su, поэтому действия администратора через sudo тоже попадают в лог.
# auid!=-1 обязателен: у демонов loginuid не задан (4294967295), а это
# число больше 1000 — без второго фильтра шум остался бы.
-a always,exit -F arch=b64 -S socket -F a0=0x2 -F auid>=1000 -F auid!=-1 -F key=network_socket_created
-a always,exit -F arch=b64 -S socket -F a0=0xA -F auid>=1000 -F auid!=-1 -F key=network_socket_created

# ------------------------------------------------------------------------------
# 7. Модули ядра
# ------------------------------------------------------------------------------
-w /sbin/insmod -p x -k kernel_modules
-w /sbin/rmmod -p x -k kernel_modules
-w /sbin/modprobe -p x -k kernel_modules
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k kernel_modules
-w /etc/modprobe.d/ -p wa -k kernel_modules_config

# ------------------------------------------------------------------------------
# 8. Файловые операции пользователей (только *at-варианты для aarch64)
# ------------------------------------------------------------------------------
-a always,exit -F arch=b64 -S fchmodat -F auid>=1000 -F auid!=-1 -F key=perm_modification
-a always,exit -F arch=b64 -S fchownat -F auid>=1000 -F auid!=-1 -F key=perm_modification
# Ключ исторически называется file_deletion, но включает и переименование
-a always,exit -F arch=b64 -S unlinkat,renameat,renameat2 -F auid>=1000 -F auid!=-1 -F key=file_deletion
-a always,exit -F arch=b64 -S mkdirat,linkat,symlinkat -F auid>=1000 -F auid!=-1 -F key=file_creation
# Неудачные попытки открыть файлы в /etc и /root — признак разведки
-a always,exit -F arch=b64 -S openat -F dir=/etc -F success=0 -F key=unauthorized_access_attempt
-a always,exit -F arch=b64 -S openat -F dir=/root -F success=0 -F key=unauthorized_access_attempt

# ------------------------------------------------------------------------------
# 9. Управление питанием
# ------------------------------------------------------------------------------
-w /sbin/shutdown -p x -k power_management
-w /sbin/reboot -p x -k power_management
-w /sbin/poweroff -p x -k power_management
